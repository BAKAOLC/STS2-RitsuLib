        "border": {
          "$value": "#465262",
          "$type": "color"
        },
        "divider": {
          "$value": "#2C333E",
          "$type": "color"
        },
        "disabled": {
          "$value": "#090B0E",
          "$type": "color"
        },
        "disabledBorder": {
          "$value": "#303943",
          "$type": "color"
        },
        "track": {
          "$value": "#354557",
          "$type": "color"
        },
        "thumb": {
          "$value": "#3C617B",
          "$type": "color"
        },
        "thumbHover": {
          "$value": "#4C7A98",
          "$type": "color"
        },
        "thumbPressed": {
          "$value": "#5D93B3",
          "$type": "color"
        },
        "successBg": {
          "$value": "#214D3B",
          "$type": "color"
        },
        "success": {
          "$value": "#91DFB0",
          "$type": "color"
        },
        "danger": {
          "$value": "#F0A29F",
          "$type": "color"
        },
        "dangerBg": {
